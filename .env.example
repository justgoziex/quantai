# ── Auth + embedded wallets (Privy) ─────────────────────────────
# Create a free app at https://dashboard.privy.io
#  1. Login methods: enable Email and Google
#  2. Embedded wallets: EVM, "create on login for users without wallets"
#  3. Copy the App ID below, then restart the dev server / rebuild
NEXT_PUBLIC_PRIVY_APP_ID=

# ── Database (Prisma + PostgreSQL) ──────────────────────────────
# Local Postgres needs sslmode=disable (Prisma 7 defaults to SSL).
# After setting: npx prisma migrate dev && npx prisma db seed
DATABASE_URL="postgresql://USER@127.0.0.1:5432/quantai?sslmode=disable"

# ── AI analysis ─────────────────────────────────────────────────
# Powers the per-token "Quant AI analysis" panel.
# Providers are tried in this order: Vertex AI → Gemini API → Claude.
# ⚠ Put real keys in .env.local, never in this file — this one is a template.
#
# OPTION A (preferred) — Vertex AI Gemini, billed to your GCP project
# (the $300 free credit applies). Setup in Google Cloud Console:
#   1. console.cloud.google.com → create/select a project
#   2. Search "Vertex AI API" → Enable
#   3. IAM & Admin → Service Accounts → Create ("quantai-vertex")
#      → grant role "Vertex AI User"
#   4. That account → Keys → Add key → JSON → download the file
#   5. Fill these two lines in .env.local and restart:
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GOOGLE_CLOUD_LOCATION=global        # optional, defaults to global
# GOOGLE_VERTEX_API_KEY=              # alternative: Vertex "express mode" key,
#                                     # no service account needed

# OPTION B — Gemini API key (aistudio.google.com, separate free tier)
GEMINI_API_KEY=

# OPTION C — Claude (console.anthropic.com)
ANTHROPIC_API_KEY=

# ── Optional / later ────────────────────────────────────────────
# ETHERSCAN_API_KEY=
# BSCSCAN_API_KEY=
